    },
    "constant": {
      "expression": "x[i,j] = value",
      "dtype": "float32"
    },
    "alternating": {
      "expression": "20 if (i+j)%2 == 0 else -20",
      "dtype": "float32"
    },
    "single_peak": {
      "expression": "20 if j == (N-1-17*i)%N else -20",
      "dtype": "float32"
    },
    "near_equal": {
      "expression": "(-1)^i * 19 + ((j%5)-2) * 2^-12",
      "dtype": "float32"
    },
    "permuted_ramp": {
      "expression": "-20 + 40 * (((j*(2*i+1)+i)%N)/(N-1))",
      "dtype": "float32",
      "operation_order": "compute modular numerator as integer, convert to FP32, divide by FP32(N-1), multiply by FP32(40), add FP32(-20)"
    }
  },
