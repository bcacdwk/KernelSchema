  "path_semantics": "repository_path is checkout-relative input metadata, not a bundle Ref. K2 copies selected actual bytes and maps them to stable artifact Ref paths.",
  "workflow_objective_count": 1,
  "permissions": {
    "design": "only public entries authorized for planner; no R0 Schema, r0_review, starter/seed or private evaluator",
    "optimize": "public entries plus the explicit current Schema/scope and authorized settled feedback/evidence; never unselected hand R0 as answer",
    "coder": "authorized public entries, selected complete Schema, fixed assignment and exact starter/seed snapshot; writable source only",
    "reviewer": "selected exact Schema/C/rules and authorized evidence; independent read-only role, no private evaluator source by default",
    "host_only": [
      "task/inputs.json",
      "evaluator/golden.py",
      "evaluator/baseline.py",
      "evaluator/interface.md",
      "evaluator/manifest.json"
    ],
    "fixed_r0_only": [
      "schema/root.yaml",
      "schema/dispatch.md",
      "schema/r0_review.md"
    ],
    "source_seed": "starter/kernel.py is explicit Source input, not baseline or a universal planner material",
    "mount_rule": "Never mount an entire checkout, input root, schema directory or evaluator directory. Visible metadata/path/digest does not grant file read. Enforce for first call, repairs, retries, resume and reopen."
  }
