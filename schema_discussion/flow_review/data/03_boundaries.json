  "findings": [
    {
      "id": "sparse_hidden",
      "decision": "clarify",
      "classification": "external_endpoint_not_structured",
      "minimum": "Caller-prior completion precedes probe/prefix; probe completion precedes remainder; prefix/remainder completion precedes caller continuation; no prefix-to-remainder barrier.",
      "least_form": "Common compute-request caller boundary plus existing launch edges.",
      "requires_new_fixed_field": false
    },
    {
      "id": "mla_geo",
      "decision": "clarify",
      "classification": "external_ready_not_structured",
      "minimum": "Geo upload completes before main grid starts; side metadata preparation has no caller-prior wait in source.",
      "least_form": "One launch-scoped prerequisite sentence; optional external.Geo.ready reference if structural addressing is required.",
      "requires_new_fixed_field": false
    },
    {
      "id": "moe_memset",
      "decision": "retain",
      "classification": "necessary_initialization_not_fully_covered_by_handoff_initialize",
      "minimum": "Zero Counts and Fill before count on each pipeline execution; retain atomics initial identity and the actual initialization work.",
      "least_form": "Short per-phase prerequisite; do not misdeclare Fill as count-produced handoff.",
      "requires_new_fixed_field": false
    },
    {
      "id": "gdn_scratch",
      "decision": "retain",
      "classification": "cross_invocation_scope_condition",
      "minimum": "Shared workspace on same device/capacity; current consumed regions rewritten; ordered reuse only; no source cross-stream exclusion.",
      "least_form": "Single short source/reuse condition; no allocator graph.",
      "requires_new_fixed_field": false
    },
    {
      "id": "mla_queue",
      "decision": "retain",
      "classification": "existing_refill_carrier",
      "minimum": "Initially zero; WorkCount pops including one terminal per CTA; final pop resets for next ordered use.",
      "least_form": "One refill protocol; does not establish safe shared Geo overwrite.",
      "requires_new_fixed_field": false
    },
    {
      "id": "qsa_ticket",
      "decision": "retain",
      "classification": "existing_refill_carrier",
      "minimum": "Serialized eager uses increasing ticket and launch base with Delta=worktile_count+worker_count; no per-call reset.",
      "least_form": "One refill protocol plus invocation scope; no implied replay repair.",
      "requires_new_fixed_field": false
    },
    {
      "id": "host_gate",
      "decision": "do_not_add_flow_runtime",
      "classification": "source_limitation_and_observation_semantics",
      "minimum": "Observed host sample/verdict is not GPU completion; CPU reset can race earlier GPU writer despite same-stream GPU execution.",
      "least_form": "Keep actual observation definition and short source limitation; do not insert generation/waits.",
      "requires_new_fixed_field": false
    },
    {
      "id": "host_completion",
      "decision": "scope_exclusion",
      "classification": "complete_wrapper_timing_not_covered",
      "minimum": "Device-wide host synchronize before table-ready publication differs from init_tables.kernel_done; Sparse capture also performs caller-stream host wait.",
      "least_form": "Short source condition unless full wrapper scheduling becomes an explicit objective.",
      "requires_new_fixed_field": false
    },
    {
      "id": "source_failure_not_default",
      "decision": "do_not_infer_edges",
      "classification": "source_failure_outside_root_selection",
      "minimum": "MoE failed BeginCapture can still execute private pipeline then eager fallback, with no fork/join established by failure; root explicitly excludes extra uncaptured pipeline.",
      "least_form": "Keep actual selection/scope and source limitation; do not force standard safe boundary onto failure.",
      "requires_new_fixed_field": false
    }
