      "support": [
        "I03",
        "I06",
        "N2"
      ]
    },
    {
      "id": "event_expansion",
      "recommendation": "Treat aliases as existing event references. Source sets are all required; wait_at targets each selected event individually. Reuse existing instance identity and value/region matching.",
