        "atol": 0.005,
        "rtol": 0.001
      }
    },
    "mutates_inputs": [
      "output",
      "output_state"
    ],
    "scratch_inputs": [],
    "acceptance": "Every element must satisfy abs(candidate-reference) <= atol + rtol*abs(reference); no relative-L2 or mismatch-rate replacement.",
    "timed_boundary": "Model.forward: GDN core plus required official wrapper work (including int64 cu_seqlens to int32 conversion). Input generation, BF16 K normalize, continuation prefix, output allocation/NaN fill and source checks excluded.",
    "minimum_seed_policy": "At least six independently seeded inputs per geometric case; deterministic_input_seed records each seed.",
    "reference": {
      "repository": "https://github.com/flashinfer-ai/flashinfer",
      "commit": "2ab910c58fdd2392914ea05e2a8714946ac0eef6",
      "file": "tests/gdn/reference_delta_rule.py",
      "function": "blockwise_delta_rule",
      "block_size": 32,
      "qkv_compute_dtype": "float32",
      "adapters": [
        "packed interface",
        "BF16 output cast",
        "state layout transpose [B,H,V,K] <-> [B,H,K,V]"
      ]
    },
    "baseline": {
      "file": "solution.py",
      "callable": "flashinfer.gdn_prefill.chunk_gated_delta_rule",
      "use_cp": false,
      "source_pin": "flashinfer_pin.json",
      "scope": "fixed comparison baseline; candidate algorithm and chunk size are unrestricted"
    },
    "inputs": {
      "q": "BF16 [T,4,128], unnormalized",
      "k": "BF16 [T,4,128], torch.nn.functional.normalize on BF16 generator output",
      "v": "BF16 [T,32,128]",
      "alpha": "FP32 [T,32], U(0,1), linear decay",
      "beta": "FP32 [T,32], U(0,1)",
      "initial_state": "FP32 [B,32,128,128] in [B,H,V,K] order; zero or continuation",
      "cu_seqlens": "int64 [B+1], starts 0, strictly increasing, ends T",
      "scale": 0.08838834764831845,
      "output": "Preallocated BF16 [T,32,128], filled with NaN before calls",
      "output_state": "Preallocated FP32 [B,32,128,128] [B,H,V,K], filled with NaN before calls"
    },
    "input_distribution": "Exact pinned gen_qkv: independent row centres Normal(0,0.05), elements Uniform(centre-0.25,centre+0.25), then BF16.",
    "initial_state_scenarios": {
      "zero": "Explicit all-zero FP32 state",
      "continuation": "Final state of one independently generated 32-token prefix per sequence using pinned reference and the same official numerical contract; excluded from timing"
    },
    "excluded_operations": [
      "Q/K normalization inside the kernel",
      "raw gate projections or softplus/sigmoid gate computation",
      "state pool gather/scatter",
      "context parallel communication"
    ]
  },
