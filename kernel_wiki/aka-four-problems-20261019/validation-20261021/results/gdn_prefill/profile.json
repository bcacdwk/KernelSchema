      "output",
      "output_state"
    ],
    "scratch_inputs": [],
    "acceptance": "Every element must satisfy abs(candidate-reference) <= atol + rtol*abs(reference); no relative-L2 or mismatch-rate replacement.",
    "timed_boundary": "Model.forward: GDN core plus required official wrapper work (including int64 cu_seqlens to int32 conversion). Input generation, BF16 K normalize, continuation prefix, output allocation/NaN fill and source checks excluded.",
